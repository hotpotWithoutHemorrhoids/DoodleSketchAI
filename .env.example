# DoodleSketchAI 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# 基础配置
DEBUG=true
PROJECT_NAME=DoodleSketchAI
VERSION=1.0.0
SECRET_KEY=your-secret-key-here

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=doodlesketch
DB_PASSWORD=doodlesketch123
DB_NAME=doodlesketchai
DATABASE_URL=mysql+pymysql://doodlesketch:doodlesketch123@localhost:3306/doodlesketchai

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# CORS 配置
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,wmv,flv,webm
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# C++ 服务配置
CPP_SERVICE_HOST=localhost
CPP_SERVICE_PORT=50051
CPP_SERVICE_URL=localhost:50051

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# 任务队列配置
TASK_QUEUE_NAME=doodlesketch_tasks
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# 缓存配置
CACHE_TTL=3600
SESSION_TTL=86400

# 性能配置
WORKERS=1
LIMIT_CONCURRENT_REQUESTS=1000
LIMIT_CONNECTIONS=100

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090

# 安全配置
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true

# AI 模型配置
U2NET_MODEL_PATH=models/u2net.pth
SKETCH_MODEL_PATH=models/sketch_model.onnx
MODEL_DEVICE=cpu

# 外部服务配置
NOTIFICATION_SERVICE_URL=
ANALYTICS_SERVICE_URL=

# 前端配置
VITE_API_BASE_URL=http://localhost:8000

# 容器环境配置（生产环境）
# DEBUG=false
# BACKEND_CORS_ORIGINS=https://yourdomain.com
# SESSION_COOKIE_SECURE=true
# MODEL_DEVICE=cuda
